# ============================================================
# 本地 / 运行时环境变量示例
# 使用方式：cp .env.example .env 后按需修改 .env
# 注意：.env 含密钥，不要提交到 Git
# ============================================================

# ------------------------------------------------------------
# 1) 服务端调用 STS 的长期凭证（必填）
# 作用：服务端用这对 AK 去阿里云 STS 换取临时凭证，再下发给客户端
# 要求：对应 RAM 用户需具备 AliyunSTSAssumeRoleAccess，
#       且被允许 Assume 下面的 STS_ASSUME_ROLE_ARN 角色
# ------------------------------------------------------------
ALIBABA_CLOUD_ACCESS_KEY_ID=your_ram_user_access_key_id
ALIBABA_CLOUD_ACCESS_KEY_SECRET=your_ram_user_access_key_secret

# ------------------------------------------------------------
# 2) 客户端直连 AssumeRole 的专用凭证（可选）
# 作用：如果客户端走“自助 AssumeRole”链路，可用这对更受限的 AK
# 留空时：自动回退使用上面的 ALIBABA_CLOUD_ACCESS_KEY_*
# 建议：生产环境尽量单独配置权限更小的专用 AK
# ------------------------------------------------------------
STS_BROKER_ACCESS_KEY_ID=
STS_BROKER_ACCESS_KEY_SECRET=

# ------------------------------------------------------------
# 3) STS 角色与会话参数
# ------------------------------------------------------------
# 必填。要扮演的 RAM 角色 ARN；该角色应具备目标 OSS Bucket/前缀访问权限
# 格式：acs:ram::<主账号ID>:role/<角色名>
STS_ASSUME_ROLE_ARN=acs:ram::1234567890123456:role/your-oss-role

# 可选。STS 会话名称，用于审计/日志区分调用方，无特殊要求可保持默认
STS_ROLE_SESSION_NAME=private-domain-drive-session

# 可选。临时凭证有效期（秒）。默认 3600=1 小时
# 客户端会在到期前刷新；过短会增加刷新频率，过长会放大凭证泄露窗口
STS_DURATION_SECONDS=3600

# 可选。STS 服务接入点，需与账号所在区域匹配
# 常见：sts.cn-hangzhou.aliyuncs.com / sts.cn-beijing.aliyuncs.com
STS_ENDPOINT=sts.cn-hangzhou.aliyuncs.com

# ------------------------------------------------------------
# 4) OSS 资源信息（下发给客户端，用于直连上传/下载）
# ------------------------------------------------------------
# 可选。目标 Bucket 名称
OSS_BUCKET=private-domain-drive

# 可选。Bucket 所在地域，例如 cn-hangzhou、cn-beijing
OSS_REGION=cn-hangzhou

# 可选。OSS Endpoint，需与地域一致
# 公网示例：oss-cn-hangzhou.aliyuncs.com
# 内网示例：oss-cn-hangzhou-internal.aliyuncs.com
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# 可选。允许客户端访问的对象键前缀（目录边界）
# 建议以 / 结尾；服务端会据此收紧 STS 权限范围
OSS_ROOT_PREFIX=shared/

# ------------------------------------------------------------
# 5) 客户端能力约束（通过 capabilities 接口下发）
# ------------------------------------------------------------
# 可选。文本预览允许读取的最大字节数。默认 524288=512KB
# 超过该大小的文本文件，客户端应提示“过大不支持完整预览”
TEXT_PREVIEW_MAX_BYTES=524288

# 可选。建议开启分片上传的文件大小阈值（字节）。默认 10485760=10MB
# 大于该阈值时，客户端应优先走 multipart 上传
MULTIPART_UPLOAD_THRESHOLD_BYTES=10485760

# 可选。允许预览的文件扩展名白名单，逗号分隔，不区分大小写
# 不在名单内的类型可下载，但不提供应用内预览
ALLOWED_PREVIEW_EXTENSIONS=jpg,jpeg,png,gif,pdf,txt,md

# ------------------------------------------------------------
# 6) 本地调试专用（线上 FC 不需要）
# ------------------------------------------------------------
# 可选。本地 node local.js 监听端口，默认 9000
PORT=9000
