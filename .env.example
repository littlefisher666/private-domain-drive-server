# ============================================================
# 服务端运行时环境变量示例
# 使用方式：cp .env.example .env 后按需修改 .env
# 注意：.env 含密钥，不要提交到 Git
#
# 说明：
# - 本文件只覆盖“服务端运行时”配置（本地 node / FC 环境变量）
# - 认证模式：双 AKSK 直连，不再使用 STS AssumeRole
# - 客户端 OSS 凭证（PDD_CLIENT_OSS_*）由服务端持有，登录时经 bootstrap 下发，
#   客户端不内置、不随构建注入
# - 部署凭证（PDD_DEPLOY_* / PDD_FC_ROLE_ARN）配置到 GitHub Actions Secrets
#   或本地 Serverless Devs，不写入本文件
# ============================================================

# ------------------------------------------------------------
# 1) 服务端访问 OSS 的长期凭证（必填）
# 对应身份：RAM 用户 pdd-server
# 授权策略：pdd-server-oss（仅允许读写 config/users.json）
# 作用：服务端读取用户目录校验登录口令，改密后回写该对象
# ------------------------------------------------------------
PDD_SERVER_OSS_ACCESS_KEY_ID=your_pdd_server_access_key_id
PDD_SERVER_OSS_ACCESS_KEY_SECRET=your_pdd_server_access_key_secret

# ------------------------------------------------------------
# 2) 下发给客户端的 OSS 凭证（必填）
# 对应身份：RAM 用户 pdd-client
# 授权策略：pdd-client-oss（仅允许 shared/ 前缀）
# 作用：登录 bootstrap 时随响应返回给客户端，客户端在本次会话内
#   直连 OSS；退出登录由客户端清除。服务端仅代为保管与下发
# ------------------------------------------------------------
PDD_CLIENT_OSS_ACCESS_KEY_ID=your_pdd_client_access_key_id
PDD_CLIENT_OSS_ACCESS_KEY_SECRET=your_pdd_client_access_key_secret

# ------------------------------------------------------------
# 3) OSS 资源信息（下发给客户端，用于直连上传/下载）
# ------------------------------------------------------------
# 可选。目标 Bucket 名称（华东1 杭州）
PDD_OSS_BUCKET=private-domain-drive

# 可选。Bucket 所在地域，例如 cn-hangzhou、cn-beijing
PDD_OSS_REGION=cn-hangzhou

# 可选。OSS Endpoint，需与地域一致
# 公网示例：oss-cn-hangzhou.aliyuncs.com
# 内网示例：oss-cn-hangzhou-internal.aliyuncs.com
PDD_OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# 可选。允许客户端访问的对象键前缀（目录边界）
# 建议以 / 结尾；客户端 OSS 权限被限制在该前缀内
PDD_OSS_ROOT_PREFIX=shared/

# ------------------------------------------------------------
# 4) 客户端能力约束（通过 bootstrap 下发）
# ------------------------------------------------------------
# 可选。文本预览允许读取的最大字节数。默认 524288=512KB
# 超过该大小的文本文件，客户端应提示“过大不支持完整预览”
PDD_TEXT_PREVIEW_MAX_BYTES=524288

# 可选。建议开启分片上传的文件大小阈值（字节）。默认 10485760=10MB
# 大于该阈值时，客户端应优先走 multipart 上传
PDD_MULTIPART_UPLOAD_THRESHOLD_BYTES=10485760

# 可选。允许预览的文件扩展名白名单，逗号分隔，不区分大小写
# 不在名单内的类型可下载，但不提供应用内预览
PDD_ALLOWED_PREVIEW_EXTENSIONS=jpg,jpeg,png,gif,pdf,txt,md

# ------------------------------------------------------------
# 5) 本地调试专用（线上 FC 不需要）
# ------------------------------------------------------------
# 可选。本地 node local.js 监听端口，默认 9000
PORT=9000
